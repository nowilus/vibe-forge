# --- Self-hosted Postgres .env.example --------------------------------------
# Generated for <<PROJECT_NAME>>. Copy to `.env`, fill values, never commit.
#
# Layout:
#   - Connection strings for app + migrations.
#   - Auth provider details (project depends on chosen auth — Clerk / Auth.js / custom).
#   - Storage provider details (S3-compatible by default).

# Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional: separate URL for migrations (recommended in production)
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Auth (placeholder — replace section based on chosen provider)
AUTH_SECRET=replace-with-long-random
AUTH_PROVIDER=clerk    # or "auth.js", "custom", "lucia", ...
# CLERK_SECRET_KEY=...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=...

# Object storage (S3-compatible)
S3_ENDPOINT=https://s3.region.example.com
S3_REGION=eu-central-1
S3_BUCKET=<<PROJECT_NAME>>-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# App
APP_NAME=<<PROJECT_NAME>>
APP_ENV=development
APP_BASE_URL=http://localhost:3000
