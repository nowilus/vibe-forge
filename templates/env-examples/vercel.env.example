# --- Vercel-hosted app .env.example -----------------------------------------
# Generated for <<PROJECT_NAME>>. Copy to `.env.local` for local dev. In Vercel,
# configure these in the dashboard (Settings → Environment Variables), scoped
# to Production / Preview / Development as appropriate.
#
# This file is hosting-focused; layer it on top of one of the data-stack
# env files (supabase / firebase / postgres) generated for your project.

# Vercel injects most NEXT_PUBLIC_VERCEL_* / VERCEL_* variables automatically;
# do not redefine them locally unless you need to override.

# Public app
NEXT_PUBLIC_APP_NAME=<<PROJECT_NAME>>
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

# Server-only
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_TELEMETRY_DISABLED=1

# Cron / scheduled functions (Vercel Cron) — store secrets here, reference in vercel.json
CRON_SECRET=replace-with-long-random
