# --- Supabase stack .env.example --------------------------------------------
# Generated for <<PROJECT_NAME>>. Copy to `.env`, fill values, never commit.
#
# Where to find each value:
#   - URL + anon key:    Supabase dashboard → Project Settings → API
#   - Service role key:  Supabase dashboard → Project Settings → API (SERVER ONLY)
#   - JWT secret:        Supabase dashboard → Project Settings → API → JWT Settings
#   - DB connection:     Supabase dashboard → Project Settings → Database

# Public client-side values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only secrets (NEVER expose to the browser, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=replace-me

# Direct DB connection (for migrations, server scripts, admin tools)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# App
APP_NAME=<<PROJECT_NAME>>
APP_ENV=development
APP_BASE_URL=http://localhost:3000
