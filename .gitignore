# --- vibe-forge baseline .gitignore -----------------------------------------
# This is the MINIMAL .gitignore shipped with the framework.
# After running INIT_PROMPT, the LLM will append stack-specific entries
# (node_modules, .next, dist, .venv, etc.) based on your answers.

# Secrets & environment
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local-only LLM agent state (used by some tools)
.cursor/scratch/
.cursor/cache/
.claude/cache/
.codex/cache/

# vibe-forge internal artefacts created during interview
.vibe-forge/used/

# Framework maintainer — local LLM session map (see repo README “Repository layout” to recreate)
FRAMEWORK_MAP.local.md

# icons
vibe-forge-icons/

# GUI internal planning / design docs (not for public consumption)
GUI_PLAN.md
.claude/DESIGN.md
.claude/PRODUCT.md
